# AI BOOK GENERATOR CONFIGURATION

# Provider and model selection
MODEL_TYPE=ollama
# SELECTED_MODEL=ollama:gpt-oss:20b-cloud
OLLAMA_API_BASE=http://localhost:11434
# OLLAMA_MODEL=gpt-oss:20b-cloud

# OPENAI_API_KEY=your_key_here
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=your-openai-model

# GROQ_API_KEY=your_key_here
# GROQ_AVAILABLE_MODELS=qwen-qwq-32b,llama3-8b-8192,mixtral-8x7b-32768

# DEEPSEEK_API_KEY=your_key_here
# DEEPSEEK_AVAILABLE_MODELS=deepseek-chat,deepseek-reasoner

# ANTHROPIC_API_KEY=your_key_here
# ANTHROPIC_AVAILABLE_MODELS=your-claude-model

# Generation defaults. English is primary; use es for Spanish books.
GEN_DEFAULT_LANGUAGE=en
GEN_DEFAULT_SUBJECT=An adventure in a cyberpunk world
GEN_DEFAULT_PROFILE=A rebellious protagonist confronting a dystopian system
GEN_DEFAULT_STYLE=Epic, imaginative, and character-driven
GEN_DEFAULT_GENRE=Cyberpunk
GEN_DEFAULT_OUTPUT_FORMAT=docx
GEN_OUTPUT_DIRECTORY=./books

# Canonical bible/wiki depth and adaptive editable-vault indexing
BIBLE_VOLUME_TARGET_WORDS=1400
BIBLE_VOLUME_MIN_WORDS=500
BIBLE_PRIOR_CONTEXT_CHARS=24000
BIBLE_QUALITY_MAX_REPAIRS=2
BIBLE_ADAPTIVE_REPAIRS=2
FRAMEWORK_QUALITY_MAX_REPAIRS=2
FRAMEWORK_GUIDANCE_REPLAYS=2
FRAMEWORK_ADAPTIVE_REPAIRS=2
WIKI_BIBLE_CONTEXT_CHARS=50000
WIKI_QUALITY_MAX_REPAIRS=2
WIKI_ITEM_MIN_WORDS=60
SOURCE_DIGEST_CHUNK_CHARS=14000
SOURCE_DIGEST_MAX_CHUNKS=8
SOURCE_DIGEST_OVERLAP_CHARS=350
VAULT_INDEX_BATCH_CHARS=14000
VAULT_INDEX_MAX_FILE_CHARS=30000
VAULT_INDEX_REBUILD_RATIO=0.35
VAULT_INDEX_REBUILD_COUNT=24

# Bounded author-agent runtime, Obsidian tools, and optional web research
AGENT_TOOLS_ENABLED=true
AGENT_MAX_ROUNDS=8
AGENT_MAX_CALLS_PER_CHAPTER=16
AGENT_RESULT_MAX_CHARS=4000
AGENT_OLLAMA_TIMEOUT=60
WEB_SEARCH_TIMEOUT=12
WEB_PAGE_MAX_BYTES=1500000
# DUCKDUCKGO_SEARCH_URL=https://html.duckduckgo.com/html/
CLI_PROVIDER_TIMEOUT=600
WEB_DEBUG=false
# BOOKGEN_PROVIDER_STORE=./.bookgen/providers.json

# Retry policy
RETRY_MAX_ATTEMPTS=3
RETRY_TIMEOUT=60
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=10.0
RETRY_BACKOFF_STRATEGY=exponential

# Socket.IO
SOCKETIO_PING_INTERVAL=25
SOCKETIO_PING_TIMEOUT=3600
SOCKETIO_ASYNC_MODE=threading
SOCKETIO_CORS_ORIGINS=*

# Provider pacing in seconds
RATE_LIMIT_DEFAULT_DELAY=0.5
RATE_LIMIT_OPENAI_DELAY=1.0
RATE_LIMIT_GROQ_DELAY=0.5
RATE_LIMIT_DEEPSEEK_DELAY=1.0
RATE_LIMIT_ANTHROPIC_DELAY=1.0
RATE_LIMIT_OLLAMA_DELAY=0.1

# Context budgets in characters
CONTEXT_LIMITED_SIZE=2000
CONTEXT_STANDARD_SIZE=8000
CONTEXT_SAVEPOINT_INTERVAL=3
CONTEXT_MAX_ACCUMULATION=5000
CONTEXT_GLOBAL_LIMIT=1000
CONTEXT_ENABLE_MICRO_SUMMARIES=false
CONTEXT_MICRO_SUMMARY_INTERVAL=3
CONTEXT_REQUIRE_DYNAMIC_ANALYZERS=false
USE_INTELLIGENT_CONTEXT=true
MODEL_CONTEXT_SIZE=limited

# LLM sampling
LLM_TEMPERATURE=0.7
LLM_STREAMING=true
LLM_TOP_K=50
LLM_TOP_P=0.9
LLM_REPEAT_PENALTY=1.1
# LLM_MAX_TOKENS=4096

# Summary and validity limits
SUMMARY_SAVEPOINT_SECTION_MAX_CHARS=1500
SUMMARY_SAVEPOINT_MAX_CHARS=500
SUMMARY_SAVEPOINT_MIN_CHARS=20
SUMMARY_SAVEPOINT_EMERGENCY_SECTION_CHARS=300
SUMMARY_CHAPTER_MAX_CHARS=300
SUMMARY_CHAPTER_MIN_CHARS=30
SUMMARY_CHAPTER_SEGMENT_LENGTH=1000
SUMMARY_CHAPTER_MAX_SEGMENTS=3
SUMMARY_CHAPTER_OPTIMIZED_MAX_CHARS=3000
SUMMARY_CHAPTER_OPTIMIZED_PART_CHARS=1000
SUMMARY_CHAPTER_OPTIMIZED_MIDDLE_CHARS=500
SUMMARY_INTELLIGENT_CHAPTER_MAX_CHARS=500
SUMMARY_MICRO_PROMPT_MAX_CHARS=1500
SUMMARY_MICRO_MIN_CHARS=20
SUMMARY_MICRO_BASE_MAX_WORDS=100
SUMMARY_GLOBAL_CONDENSE_THRESHOLD_CHARS=800
SUMMARY_GLOBAL_MAX_CHARS=400
SUMMARY_GLOBAL_TRUNCATE_CHARS=500
SUMMARY_CURRENT_CHAPTER_CONTEXT_MAX_CHARS=800
SUMMARY_SECTION_MIN_CHARS=300

# Few-shot examples
USE_FEW_SHOT_LEARNING=true
EXAMPLE_QUALITY_THRESHOLD=0.75
MAX_EXAMPLES_PER_PROMPT=2
EXAMPLES_STORAGE_PATH=./data/examples
FEW_SHOT_AUTO_SAVE=true

# Logging and streaming
LOG_LEVEL=INFO
STREAMING_WORD_BUFFER_SIZE=50
STREAMING_WORD_DELIMITERS= ,.\n\t;:!?"'()[]{}
